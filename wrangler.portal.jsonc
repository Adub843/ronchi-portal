// Ronchi Portal: the STAFF side. Signed-in staff only.
// It owns portal-db (the business store). The help center never gets this binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ronchi-portal",
  "main": "src/portal/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first so every page gets the security headers.
    "run_worker_first": true
  },
  "d1_databases": [
    // database_id is filled in once with `wrangler d1 create portal-db` (see REBUILD.md).
    { "binding": "DB", "database_name": "portal-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/portal" }
  ],
  "r2_buckets": [
    // Photos and files sent in boards and chats. Created once with `wrangler r2 bucket create ronchi-portal-files`.
    { "binding": "FILES", "bucket_name": "ronchi-portal-files" }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    // Local development values. The live values are set under env.production below.
    "ORIGIN": "http://localhost:8787",
    "RP_ID": "localhost",
    "RP_NAME": "Ronchi Portal"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "ronchi-portal",
      "vars": { "ORIGIN": "https://portal.ronchiamerica.com", "RP_ID": "portal.ronchiamerica.com", "RP_NAME": "Ronchi Portal" },
      "d1_databases": [
        { "binding": "DB", "database_name": "portal-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/portal" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ronchi-portal-files" }],
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
